# ===== Hy3 API 接入（必填一项：api_key）=====
# 形如 OpenAI 兼容的 chat/completions 接口。
# 把下面的值改成你自己的 Hy3 接入信息（不要提交本文件）。

# Hy3 API Key（必填；不填则自动进入 mock 模式）
HY3_API_KEY=

# API Base URL，需指向 /chat/completions 所在的基础路径
# 默认值（犀牛鸟 2026 活动提交所用）：
HY3_BASE_URL=http://101.43.51.108:3000/v1

# 模型名（按你拿到的 Hy3 模型名填写）
# 默认值（犀牛鸟 2026 活动提交所用）：
HY3_MODEL=hunyuan-3.0-free

# 目标系统：linux / macos / windows（留空则自动检测）
HY3_OS=

# 可选调参
HY3_TEMPERATURE=0.2
# hunyuan-3.0-free 是推理模型，会消耗大量 token 用于思考；
# 必须给足 max_tokens，否则最终 JSON 会被截断为空。
HY3_MAX_TOKENS=4096
HY3_TIMEOUT=120

# 强制 mock 模式（离线开发/演示用，无需 key）
HY3_MOCK=0
